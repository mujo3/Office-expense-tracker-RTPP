# Kopiraj ovaj fajl u .env i popuni svojim vrijednostima:
#   cp .env.example .env
# Fajl .env je u .gitignore i ne smije se commitati.

FLASK_APP=rtpp_app
FLASK_ENV=development

# PostgreSQL konekcija. Ako se izostavi, config.py pada na lokalni SQLite (app.db).
DATABASE_URL=postgresql://korisnik:lozinka@host:5432/ime_baze

# Kljuc za potpisivanje sesija i reset tokena.
# Generisi novi sa: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=promijeni_me

# SMTP za slanje linkova za reset lozinke
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=adresa@primjer.com
MAIL_PASSWORD=app_lozinka
MAIL_DEFAULT_SENDER=adresa@primjer.com
